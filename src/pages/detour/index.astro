---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { toSlug } from '../../lib/slug';

const entries = await getCollection('detour');
const sorted = entries.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const allTags = [...new Set(sorted.flatMap((e) => e.data.tags))].sort();
---

<BaseLayout title="Detour" description="寄り道の記録">
  <h1>Detour</h1>
  <p>寄り道の記録。{sorted.length}件。</p>

  {allTags.length > 0 && (
    <ul class="tags">
      {allTags.map((tag) => <li>{tag}</li>)}
    </ul>
  )}

  <ul class="entries">
    {sorted.map((entry) => (
      <li>
        <a href={`/detour/${toSlug(entry.id)}/`}>{entry.data.title}</a>
        {entry.data.url && <span class="external">↗</span>}
        {entry.data.defunct && <span class="defunct">（閉鎖）</span>}
        <span class="date">{entry.data.date.toLocaleDateString('ja-JP')}</span>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
  }

  .tags li {
    font-size: 0.875rem;
    background: var(--colors-tag-bg, #1a1a1a14);
    padding: 0.125rem 0.5rem;
    border-radius: 2px;
  }

  .entries {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
  }

  .entries li {
    margin-bottom: 0.75rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .entries li a {
    flex-shrink: 0;
  }

  .external {
    font-size: 0.75rem;
    opacity: 0.5;
  }

  .defunct {
    font-size: 0.875rem;
    opacity: 0.7;
  }

  .date {
    font-size: 0.875rem;
    opacity: 0.7;
    margin-left: auto;
    white-space: nowrap;
  }
</style>
