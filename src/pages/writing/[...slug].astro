---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { toSlug } from '../../lib/slug';

export async function getStaticPaths() {
  const entries = await getCollection('writing');
  return entries.map((entry) => ({
    params: { slug: toSlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} ogType="article" lang={entry.data.lang}>
  <article data-pagefind-body>
    <h1 data-pagefind-meta="title">{entry.data.title}</h1>

    {entry.data.url && (
      <p class="url">
        <a href={entry.data.url} rel="noopener noreferrer" target="_blank">
          {entry.data.url}
        </a>
      </p>
    )}

    {entry.data.description && <p>{entry.data.description}</p>}

    <div class="meta">
      <time datetime={entry.data.date.toISOString()}>
        {entry.data.date.toLocaleDateString(entry.data.lang === 'en' ? 'en-US' : 'ja-JP')}
      </time>
      {entry.data.tags.length > 0 && (
        <ul class="tags">
          {entry.data.tags.map((tag) => <li><a href={`/writing/tag/${tag}/`}>{tag}</a></li>)}
        </ul>
      )}
    </div>

    {entry.data.defunct && <p class="defunct">※ このサイトは閉鎖または更新停止しています</p>}

    <hr />
    <Content />

    {entry.data.syndication.length > 0 && (
      <footer class="syndication">
        Also on {entry.data.syndication.map((url) => (
          <a href={url} rel="syndication" class="u-syndication">{new URL(url).hostname}</a>
        ))}
      </footer>
    )}
  </article>
</BaseLayout>

<style>
  h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .url {
    margin-bottom: 0.5rem;
  }

  .meta {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    font-size: 0.875rem;
    opacity: 0.7;
    margin-bottom: 1.5rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tags li {
    background: var(--colors-tag-bg, #1a1a1a14);
    padding: 0.125rem 0.5rem;
    border-radius: 2px;
  }

  time {
    white-space: nowrap;
  }

  .defunct {
    font-weight: bold;
    margin-top: 1rem;
  }

  .syndication {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--colors-border, #1a1a1a33);
    font-size: 0.875rem;
    opacity: 0.7;
  }

  hr {
    border: none;
    border-top: 1px solid var(--colors-border, #1a1a1a33);
    margin: 2rem 0;
  }
</style>
