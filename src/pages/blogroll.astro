---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = await getCollection('writing');
const withUrl = entries.filter((e) => e.data.url);
const active = withUrl
  .filter((e) => !e.data.defunct)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'ja'));
const defunct = withUrl
  .filter((e) => e.data.defunct)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'ja'));
---

<BaseLayout title="ブログロール" description="登録サイトのリンク一覧" altLangHref="/en/blogroll/">
  <h1>ブログロール</h1>

  <ul>
    {active.map((entry) => (
      <li>
        <a href={entry.data.url} rel="noopener noreferrer" target="_blank">{entry.data.title}</a>
        {entry.data.feedUrl && <span class="feed">(feed)</span>}
        — {entry.data.description}
      </li>
    ))}
  </ul>

  {defunct.length > 0 && (
    <>
      <h2>更新停止・閉鎖</h2>
      <ul>
        {defunct.map((entry) => (
          <li>
            <a href={entry.data.url} rel="noopener noreferrer" target="_blank">{entry.data.title}</a>
            — {entry.data.description}
          </li>
        ))}
      </ul>
    </>
  )}
</BaseLayout>

<style>
  h1 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }

  h2 {
    font-size: 1.25rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  ul {
    padding-left: 1.5rem;
  }

  li {
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }

  .feed {
    font-size: 0.875rem;
    opacity: 0.7;
  }
</style>
